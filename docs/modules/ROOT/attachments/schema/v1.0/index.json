{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cawg.io/schemas/odrl-c2pa/v1.0",
  "title": "CAWG ODRL Profile for C2PA",
  "description": "JSON Schema for ODRL Permissions Assertions in C2PA manifests",
  "type": "object",
  "required": [
    "@context",
    "@type", 
    "profile",
    "permission",
    "cawg:assertionRef",
    "cawg:ingredient"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 2,
      "contains": {
        "const": "https://www.w3.org/ns/odrl.jsonld"
      },
      "contains": {
        "const": "https://cawg.io/contexts/odrl-c2pa/v1"
      }
    },
    "@type": {
      "type": "string",
      "enum": ["Offer", "Agreement"]
    },
    "uid": {
      "type": "string",
      "format": "uri"
    },
    "inheritFrom": {
      "type": "string",
      "format": "uri"
    },
    "profile": {
      "type": "string",
      "const": "https://cawg.io/profiles/odrl-c2pa/v1"
    },
    "assigner": {
      "type": "string",
      "format": "uri"
    },
    "assignee": {
      "type": "string", 
      "format": "uri"
    },
    "permission": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Permission"
      }
    },
    "prohibition": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Prohibition"
      }
    },
    "obligation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Obligation"
      }
    },
    "cawg:assertionRef": {
      "type": "string",
      "format": "uri",
      "pattern": "^self#jumbf=.*cawg\\.identity$"
    },
    "cawg:ingredient": {
      "type": "string",
      "format": "uri", 
      "pattern": "^self#jumbf=.*c2pa\\.ingredient$"
    },
    "cawg:targetC2PA": {
      "type": "string",
      "format": "uri"
    },
    "cawg:status": {
      "type": "string",
      "enum": ["valid", "expired", "delinquent", "revoked"]
    }
  },
  "$defs": {
    "Permission": {
      "type": "object",
      "required": ["target", "action"],
      "properties": {
        "target": {
          "type": "string",
          "format": "uri"
        },
        "action": {
          "type": "string",
          "enum": ["c2pa.published", "c2pa.transcoded", "c2pa.repackaged"]
        },
        "constraint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "refinement": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Refinement"
          }
        }
      }
    },
    "Prohibition": {
      "type": "object",
      "required": ["target", "action"],
      "properties": {
        "target": {
          "type": "string",
          "format": "uri"
        },
        "action": {
          "type": "string",
          "enum": ["c2pa.published", "c2pa.transcoded", "c2pa.repackaged"]
        },
        "constraint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        }
      }
    },
    "Obligation": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["odrl:attribute", "odrl:compensate", "odrl:delete", "odrl:distribute", "odrl:modify", "odrl:move", "odrl:nextPolicy", "odrl:obtainConsent", "odrl:pay", "odrl:read", "odrl:reproduce", "odrl:reviewPolicy", "odrl:uninstall", "odrl:watermark"]
        },
        "target": {
          "type": "string",
          "format": "uri"
        },
        "constraint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        }
      }
    },
    "Constraint": {
      "type": "object",
      "required": ["leftOperand", "operator", "rightOperand"],
      "properties": {
        "leftOperand": {
          "type": "string",
          "enum": ["odrl:dateTime", "odrl:event", "odrl:media", "odrl:recipient", "odrl:spatial", "odrl:system", "odrl:timeInterval", "odrl:unitOfCount", "odrl:virtualLocation"]
        },
        "operator": {
          "type": "string",
          "enum": ["odrl:eq", "odrl:gt", "odrl:gteq", "odrl:lt", "odrl:lteq", "odrl:neq", "odrl:isA", "odrl:hasPart", "odrl:isPartOf", "odrl:isAllOf", "odrl:isAnyOf", "odrl:isNoneOf"]
        },
        "rightOperand": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "array"}
          ]
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "Refinement": {
      "type": "object",
      "required": ["leftOperand", "operator", "rightOperand"],
      "properties": {
        "leftOperand": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["odrl:eq", "odrl:gt", "odrl:gteq", "odrl:lt", "odrl:lteq", "odrl:neq", "odrl:isA", "odrl:hasPart", "odrl:isPartOf", "odrl:isAllOf", "odrl:isAnyOf", "odrl:isNoneOf"]
        },
        "rightOperand": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "array"}
          ]
        }
      }
    }
  }
}
