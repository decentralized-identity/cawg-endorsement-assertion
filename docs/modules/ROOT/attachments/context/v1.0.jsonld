{
  "@context": {
    "@version": 1.1,
    "odrl": "https://www.w3.org/ns/odrl#",
    "cawg": "https://cawg.io/ns/odrl-c2pa#",
    "c2pa": "https://c2pa.org/ns/actions#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    
    "cawg:assertionRef": {
      "@id": "https://cawg.io/ns/odrl-c2pa#assertionRef",
      "@type": "@id",
      "@comment": "JUMBF reference to the local CAWG Identity assertion for identity binding"
    },
    
    "cawg:ingredient": {
      "@id": "https://cawg.io/ns/odrl-c2pa#ingredient", 
      "@type": "@id",
      "@comment": "JUMBF reference to the single c2pa.ingredient used as the target scope"
    },
    
    "cawg:targetC2PA": {
      "@id": "https://cawg.io/ns/odrl-c2pa#targetC2PA",
      "@type": "@id", 
      "@comment": "JUMBF of the target policy object (e.g., manifest or asset reference)"
    },
    
    "cawg:status": {
      "@id": "https://cawg.io/ns/odrl-c2pa#status",
      "@type": "@vocab",
      "@comment": "Compliance state: valid, expired, delinquent, revoked"
    },
    
    "c2pa.published": {
      "@id": "https://c2pa.org/ns/actions#published",
      "@comment": "Permission to publish the asset"
    },
    
    "c2pa.transcoded": {
      "@id": "https://c2pa.org/ns/actions#transcoded", 
      "@comment": "Permission to transcode the asset"
    },
    
    "c2pa.repackaged": {
      "@id": "https://c2pa.org/ns/actions#repackaged",
      "@comment": "Permission to repackage the asset"
    }
  }
}
